# Public site URL - used for canonical tags, Open Graph and the sitemap.
NEXT_PUBLIC_SITE_URL=https://silverroof.net

# Contact form delivery. Leave unset and the form will tell visitors to use
# WhatsApp or phone instead of silently dropping their message.
# Any endpoint that accepts a JSON POST works (Formspree, n8n, Zapier, your CRM).
CONTACT_WEBHOOK_URL=

# Marketing tags - left empty on purpose. See lib/analytics.ts.
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_META_PIXEL_ID=
